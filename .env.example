# ---------------------------------------------------------------------------
# ProofMile Escrow — dApp configuration
# Copy this file to .env.local (development) or .env (and rebuild for prod).
# No database is required: the dApp reads and writes the Intelligent
# Contract on GenLayer Studionet directly.
# ---------------------------------------------------------------------------

# THE ONLY value you must ever change after a (re)deploy.
# Paste the deployed contract address here (see docs/deployment.md).
# Current reference deployment on Studionet: 0xd429Bcfc77aBBE478c00f86cb49F85dDd32427A0
NEXT_PUBLIC_CONTRACT_ADDRESS=0xd429Bcfc77aBBE478c00f86cb49F85dDd32427A0

# GenLayer Studionet — defaults shown; override only if the network moves.
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_EXPLORER=https://explorer-studio.genlayer.com
